# LinkxDrop Environment Configuration

# Server Environment
NODE_ENV=production
PORT=3000

# Rate Limiting (Requests per minute per IP)
RATE_LIMIT_PER_MINUTE=20

# Max Media Download Size in Bytes (Default: 200MB)
MAX_FILE_SIZE_BYTES=209715200

# Temporary File Directory
TEMP_DIR=./tmp/media-downloads

# Cleanup Interval in Minutes
TEMP_CLEANUP_INTERVAL_MINS=15

# External Extraction Worker URL (Optional for separated processing workers)
# MEDIA_WORKER_URL=https://worker.linkxdrop.com/api
